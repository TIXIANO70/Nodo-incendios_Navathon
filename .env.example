# Configuración para api_sender.py (Apaso - Monitoreo de Incendios Forestales)

# URL externa donde enviar el JSON normalizado vía HTTP POST (Opcional, dejar vacío si solo se atienden peticiones GET)
TARGET_WEBHOOK_URL=

# Habilitar worker de envío periódico en segundo plano (true/false)
ENABLE_WORKER=false

# Frecuencia en segundos del worker de envío
INTERVAL_SECONDS=30

# Puerto y Host donde escuchará esta API Flask
PORT=8081
HOST=0.0.0.0

# Ruta al archivo de base de datos SQLite
DB_PATH=DBincendios.db
